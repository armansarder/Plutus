# Plutus Root Environment Configuration Example
# Copy this file to .env:
#   cp .env.example .env
#
# DO NOT commit real secrets, private tokens, or personal phone numbers to GitHub.
# .env is ignored by .gitignore.

# ==============================================================================
# 1. Plutus Core Security & Customer Binding
# ==============================================================================
FINPILOT_API_TOKEN=11efb47c713902474c38e3cc7b327e06cf08406bf1f570de4e54381ea5cb66aa
FINPILOT_CUSTOMER_ID=synthetic_demo
AGENT_DATA_SOURCE=demo
FINPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
FINPILOT_CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# 2. Photon 2.0 Integration & Delivery
# ==============================================================================
# Delivery mode: 'photon' for live iMessage sending via spectrum-ts, or 'preview_only'
PLUTUS_DELIVERY_MODE=photon

# Shared bearer secret between FastAPI and photon_service (sender.ts)
PHOTON_INTERNAL_SECRET=generate-a-secure-random-secret-with-at-least-32-chars

# Local microservice URL where photon_service runs
PHOTON_SERVICE_URL=http://127.0.0.1:8790

# Demo user (Alex Rivera) enrolled recipient configuration
# Replace with your enrolled personal test phone number in E.164 format
PLUTUS_DEMO_PHONE_E164=+1XXXXXXXXXX
PLUTUS_DEMO_AUTO_OPT_IN=true

# Private Operator Console Secret (for http://localhost:5173/operator)
PLUTUS_OPERATOR_SECRET=plutus-demo-operator-secret-2026

# ==============================================================================
# 3. Nemotron Agent (Optional / Model Features)
# ==============================================================================
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

