# Optional local council UI; default original experience remains available.
VITE_DATA_MODE=remote
VITE_COUNCIL_ENABLED=false
# Server-only: never add VITE_ to the following names.
FINPILOT_BACKEND_URL=http://127.0.0.1:8003
FINPILOT_API_TOKEN=PASTE_MATCHING_PRIVATE_BACKEND_SERVICE_TOKEN
# Load with: node --env-file=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port 8080
